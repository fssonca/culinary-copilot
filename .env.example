# Local development only. Copy to .env; never commit actual keys.
POSTGRES_DB=culinary_copilot
POSTGRES_USER=copilot
POSTGRES_PASSWORD=copilot_dev
POSTGRES_PORT=5432
API_PORT=8000
# Local Python uses localhost; Compose overrides this with the db service host.
DATABASE_URL=postgresql+psycopg://copilot:copilot_dev@localhost:5432/culinary_copilot

# Ingestion uses explicit enablement below; application clarification uses
# LLM_ENABLED (separate switch). Both default to false; default tests are
# key-free and offline.
OPENAI_API_KEY=
# Every *_MODEL setting must name a model in src/culinary_copilot/llm/models.py.
# The project uses gpt-6-luna only; any other value is refused at startup.
OPENAI_MODEL=gpt-6-luna

# Application-facing LLM for hybrid clarification planning (interactive
# Responses API, not Batch). Disabled by default; the disabled path makes
# zero provider calls. One retry owner: SDK retries are disabled and the
# application retries only retryable transport failures up to the limit below.
LLM_ENABLED=false
LLM_APP_MODEL=gpt-6-luna
LLM_APP_TIMEOUT_S=20
LLM_APP_MAX_OUTPUT_TOKENS=1500
LLM_APP_MAX_INPUT_CHARS=12000
LLM_APP_MAX_RETRIES=1

# Source-grounded recommendations (Phase 3, backend only). Separate master
# switch from clarification and ingestion: LLM_ENABLED never enables
# recommendation calls. Disabled generation fails closed (503) before any
# network access. Conservative bounded defaults; see docs/recommendations.md.
LLM_RECOMMENDATION_ENABLED=false
LLM_REC_MODEL=gpt-6-luna
LLM_REC_TIMEOUT_S=20
# Must be supported by LLM_REC_MODEL: gpt-6-luna accepts none/low/medium/
# high/xhigh/max (not minimal). Checked at startup.
LLM_REC_REASONING_EFFORT=none
LLM_REC_MAX_OUTPUT_TOKENS=6500
LLM_REC_MAX_INPUT_CHARS=12000
LLM_REC_MAX_RETRIES=1
REC_CANDIDATE_COUNT=3
REC_CANDIDATE_MAX=5
REC_EVIDENCE_MAX_CHARS=6000
REC_EPICURE_MAX_INGREDIENTS=5
REC_EPICURE_SUGGESTION_COUNT=5
REC_MAX_PROVIDER_TURNS=2
REC_MAX_TOOL_CALLS=1
# Recommendation streaming (Phase 4, SSE, text/event-stream, no new
# dependency). One workflow, two transports: POST /api/v1/recommendations
# keeps its body; POST /api/v1/recommendations/stream shares the same
# service via a stage hook. No model deltas; no provisional events.
# REC_STREAM_MAX_EVENTS bounds total SSE events per stream (stages +
# terminal; one slot is reserved for the terminal event, minimum 2);
# REC_STREAM_MAX_DURATION_S bounds total stream seconds;
# REC_STREAM_KEEPALIVE_S sets the keep-alive comment interval.
REC_STREAM_MAX_EVENTS=100
REC_STREAM_MAX_DURATION_S=120
REC_STREAM_KEEPALIVE_S=10
# Recommendation telemetry prices come from the model registry
# (src/culinary_copilot/llm/models.py), keyed by model; there is no
# setting that overrides them for whatever model happens to be configured.

# Hybrid LLM ingestion via the OpenAI Batch API (/v1/responses + structured
# outputs). Disabled by default; prepare/finalize work offline, submit is an
# explicit action and never runs in tests.
LLM_INGESTION_ENABLED=false
# gpt-6-luna has a single snapshot (gpt-6-luna). The CLI refuses to
# silently substitute a different model, including when resuming a run
# prepared with another model.
LLM_EXTRACTION_MODEL=gpt-6-luna
# Optional Responses reasoning effort; must be supported by the model
# (gpt-6-luna: none/low/medium/high/xhigh/max). Blank = server default
# (medium for gpt-6-luna).
LLM_REASONING_EFFORT=
LLM_BATCH_REQUEST_LIMIT=200
LLM_MAX_OUTPUT_TOKENS=8000
LLM_RETRY_LIMIT=2
LLM_AUDIT_SAMPLE_RATE=0.0
LLM_AUDIT_SEED=20260707
# Optional spend ceiling (USD, batch-discounted estimate).
LLM_BUDGET_USD=
# Optional per-1M-token sync list prices for the ingestion estimator, which
# applies the documented Batch discount
# (https://developers.openai.com/api/docs/guides/batch). gpt-6-luna Standard,
# verified 2026-09-24
# (https://developers.openai.com/api/docs/pricing?latest-pricing=standard):
# input $0.10, output $0.50 (cached input $0.01, cache writes $0.125). Leave
# blank and the estimator reports cost as unknown (submit then requires --limit).
LLM_PRICE_INPUT_PER_1M=0.10
LLM_PRICE_OUTPUT_PER_1M=0.50

# Epicure runs locally on CPU, only when explicitly enabled and queried.
HF_TOKEN=
EPICURE_ENABLED=false
EPICURE_MODEL_ID=Kaikaku/epicure-core
EPICURE_REVISION=d31ebb5af8e92bbaf5cb67381d5006d4ea8368b7
HF_HOME=.cache/huggingface

# Recipe-text embeddings (Phase 5, prepared offline, not activated).
# Separate registry from Luna text generation (embeddings/registry.py).
# Disabled by default: full-text mode makes zero embedding calls. Query
# and corpus vectors must share EMBEDDING_MODEL/EMBEDDING_DIMENSION.
# Batch here means multi-input synchronous /v1/embeddings requests
# (per-input 8192 tokens, aggregate 300k per request, <=2048 inputs).
EMBEDDINGS_ENABLED=false
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBED_TIMEOUT_S=20
EMBED_MAX_RETRIES=1
EMBED_BATCH_INPUTS=64
EMBED_MAX_TOKENS_PER_REQUEST=300000
EMBED_BUDGET_USD=
# Retrieval mode: fulltext (default) | vector | hybrid. Vector/hybrid need
# EMBEDDINGS_ENABLED plus a pgvector-enabled database (see
# compose.pgvector.override.yaml); otherwise they fail closed.
RETRIEVAL_MODE=fulltext
RETRIEVAL_VECTOR_CANDIDATES=20
RETRIEVAL_RRF_K=60
